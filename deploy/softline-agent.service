[Unit]
Description=Softline Presales AI Agent (FastAPI + Webim Smart Bot 2.0)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=softline
Group=softline
WorkingDirectory=/opt/softline-agent
EnvironmentFile=/opt/softline-agent/.env
Environment=FASTEMBED_CACHE_PATH=/opt/softline-agent/data/fastembed_cache
Environment=HF_HOME=/opt/softline-agent/data/hf_cache
ExecStart=/opt/softline-agent/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=always
RestartSec=3
TimeoutStopSec=30

# Service hardening (read-only app dir, writable data/ only)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/softline-agent
ReadWritePaths=/opt/softline-agent/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
